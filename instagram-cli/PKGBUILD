pkgname=instagram-cli
pkgver=2.0.1
pkgrel=1
pkgdesc="Instagram's terminal UI app - The ultimate weapon against brainrot"
arch=('any')
url="https://github.com/supreme-gg-gg/instagram-cli"
license=('MIT')
depends=('nodejs>=22')
makedepends=('npm')
options=('!strip' '!debug')
source=("https://registry.npmjs.org/@i7m/instagram-cli/-/instagram-cli-$pkgver.tgz")
sha256sums=('80e83d6093daa27fa3b0683db2fceff3adddc18f695253ede6fa909a0a5f1bb8')

build() {
    cd "$srcdir/package"
    # Runtime deps only; skip lifecycle scripts (prepare runs husky, a dev
    # dependency) and apply the bundled patches explicitly instead.
    npm install --omit=dev --ignore-scripts --no-audit --no-fund \
        --cache "$srcdir/npm-cache"
    node node_modules/patch-package/index.js
    # Stray prebuilt CI binary shipped in the ts-custom-error tarball
    find node_modules -type f -name codeclimate-reporter -delete
}

package() {
    cd "$srcdir/package"
    install -d "$pkgdir/usr/lib/$pkgname" "$pkgdir/usr/bin"
    cp -a dist node_modules package.json "$pkgdir/usr/lib/$pkgname/"
    chmod 755 "$pkgdir/usr/lib/$pkgname/dist/cli.js"
    ln -s "/usr/lib/$pkgname/dist/cli.js" "$pkgdir/usr/bin/$pkgname"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
